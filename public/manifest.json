{
  "manifest_version": 3,
  "name": "ClosetClip",
  "version": "0.1.0",
  "description": "A personal digital closet for the clothing you discover online.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ClosetClip",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
